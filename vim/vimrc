" Settings
" =============================================================================

" Leader
let mapleader = " "
let maplocalleader = " "

" Basic settings
set number
set norelativenumber
set wrap
set colorcolumn=80
set cursorline
set scrolloff=999
set sidescrolloff=50
set ignorecase
set smartcase
set incsearch
set hlsearch
set list
set listchars=tab:»\ ,trail:.,nbsp:␣
set clipboard^=unnamed,unnamedplus

" Tabs
set tabstop=4
set shiftwidth=4
set expandtab
set softtabstop=4

" Keymaps
" ============================================================================

" Clear search highlight
nnoremap <Esc> :nohlsearch<CR>

" Save file
nnoremap <C-s> :w<CR>
inoremap <C-s> <Esc>:w<CR>
vnoremap <C-s> <Esc>:w<CR>

" Windows
nnoremap <leader>wv <C-w>v
nnoremap <leader>wo <C-w>s
nnoremap <leader>wl <C-w>l
nnoremap <leader>wh <C-w>h
nnoremap <leader>wj <C-w>j
nnoremap <leader>wk <C-w>k
nnoremap <leader>w> <C-w>>
nnoremap <leader>w< <C-w><
nnoremap <leader>wx <C-w>x
nnoremap <leader>ws <C-w>w
nnoremap <leader>wn <C-w>n
nnoremap <leader>w= <C-w>=

" Tab
nnoremap <silent> <leader>tn :tabnew<CR>
nnoremap <silent> <leader>tc :tabclose<CR>
nnoremap <silent> <leader>to :tabonly<CR>
nnoremap <silent> <leader>tl :tabnext<CR>
nnoremap <silent> <leader>th :tabprevious<CR>
nnoremap <silent> <leader>t^ :tabfirst<CR>
nnoremap <silent> <leader>t$ :tablast<CR>
nnoremap <silent> <leader>t> :tabmove +1<CR>
nnoremap <silent> <leader>t< :tabmove -1<CR>
" Open current buffer in a new tab (keeps the original window intact)
nnoremap <silent> <leader>ts :tab split<CR>
for i in range(1, 9)
    execute 'nnoremap <silent> <leader>t' . i . ' :tabnext ' . i . '<CR>'
endfor

" Move lines
nnoremap <A-j> :<C-u>execute 'move .+' . v:count1<CR>==
nnoremap <A-k> :<C-u>execute 'move .-' . (v:count1 + 1)<CR>==
inoremap <A-j> <Esc>:m .+1<CR>==gi
inoremap <A-k> <Esc>:m .-2<CR>==gi
vnoremap <A-j> :<C-u>execute "'<,'>move '>+" . v:count1<CR>gv=gv
vnoremap <A-k> :<C-u>execute "'<,'>move '<-" . (v:count1 + 1)<CR>gv=gv

" Blank lines (your second version overwrites the first)
nnoremap <A-[> :<C-u>if search('^\s*$', 'bW') == 0 \| normal! gg \| endif<CR>
nnoremap <A-]> :<C-u>if search('^\s*$', 'W') == 0 \| normal! G \| endif<CR>

" Paste
nnoremap <leader>ep :iput<CR>
xnoremap P p
xnoremap p P

" Buffer
nnoremap [b :bprevious<CR>
nnoremap ]b :bnext<CR>

" Better Search Next
nnoremap <expr> n 'Nn'[v:searchforward] . 'zv'
xnoremap <expr> n 'Nn'[v:searchforward]
onoremap <expr> n 'Nn'[v:searchforward]
nnoremap <expr> N 'nN'[v:searchforward] . 'zv'
xnoremap <expr> N 'nN'[v:searchforward]
onoremap <expr> N 'nN'[v:searchforward]

" Better whitespace handling
inoremap <CR> <Space><BS><CR>
inoremap <Esc> <Space><BS><Esc>
